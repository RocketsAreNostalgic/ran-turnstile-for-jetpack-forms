{
	"name": "ran-turnstile-for-jetpack-forms",
	"private": true,
	"type": "module",
	"scripts": {
		"lint:js": "eslint \"assets/**/*.js\" \"scripts/**/*.mjs\" \".github/scripts/**/*.mjs\"",
		"format:check": "prettier --check \"assets/**/*.{js,css}\" \"scripts/**/*.mjs\" \".github/scripts/**/*.mjs\" eslint.config.mjs prettier.config.cjs package.json pnpm-workspace.yaml",
		"check": "pnpm lint:js && pnpm lint:css && pnpm format:check && node --test scripts/release-boundary.test.mjs",
		"lint:css": "stylelint \"assets/**/*.css\""
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@rocketsarenostalgic/quality-config": "github:RocketsAreNostalgic/ran-quality-config#c7ca14dfadb6584ff3baa1884579f59b2b85c757",
		"@wordpress/eslint-plugin": "25.7.0",
		"@wordpress/prettier-config": "4.51.0",
		"@wordpress/stylelint-config": "26.1.0",
		"eslint": "9.39.5",
		"prettier": "3.9.5",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"stylelint": "17.14.1",
		"stylelint-scss": "7.2.0"
	},
	"engines": {
		"node": ">=24.21.0 <25",
		"pnpm": ">=11 <12"
	},
	"packageManager": "pnpm@11.13.1"
}
