parameters:
    level: 5
    phpVersion: 80000
    paths:
        - ran-turnstile-for-jetpack-forms.php
        - includes
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    bootstrapFiles:
        - tests/phpstan/bootstrap.php
    stubFiles:
        - tests/phpstan/tag-processor.stub
    tmpDir: vendor/.cache/phpstan
